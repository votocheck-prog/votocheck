{
  "name": "votocheck-coletor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "d1:create": "wrangler d1 create votocheck-db",
    "d1:migrate:local": "wrangler d1 execute votocheck-db --local --file=migrations/0001_schema_inicial.sql",
    "d1:migrate:remote": "wrangler d1 execute votocheck-db --remote --file=migrations/0001_schema_inicial.sql",
    "importar:local": "node scripts/importar_local.mjs",
    "importar:pgfn": "node scripts/importar_pgfn.mjs"
  },
  "devDependencies": {
    "wrangler": "^3.90.0"
  },
  "dependencies": {
    "unzipit": "^1.4.3"
  }
}
